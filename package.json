{
	"name": "nexiom-monorepo",
	"private": true,
	"version": "1.0.0",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"test:cov": "turbo test:cov",
		"prepare": "husky",
		"db:migrate": "pnpm --filter @nexiom/database db:migrate",
		"db:generate": "pnpm --filter @nexiom/database db:generate",
		"db:studio": "pnpm --filter @nexiom/database db:studio",
		"db:seed": "pnpm --filter api db:seed",
		"setup:local": "cp -n .env.example .env 2>/dev/null || true && docker compose up -d && pnpm db:migrate && pnpm db:seed"
	},
	"devDependencies": {
		"@swc/cli": "^0.8.0",
		"@swc/core": "^1.15.11",
		"@types/node": "^25.0.5",
		"@vitest/coverage-v8": "^2.1.9",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"pg": "^8.16.3",
		"turbo": "^2.7.2",
		"vitest": "^2.1.9"
	},
	"lint-staged": {
		"apps/api/**/*.{ts,tsx}": [
			"pnpm -C apps/api exec eslint --fix"
		],
		"apps/worker/**/*.{ts,tsx}": [
			"pnpm -C apps/worker exec eslint --fix"
		],
		"apps/web/**/*.{ts,tsx}": [
			"pnpm -C apps/web exec eslint --fix"
		],
		"packages/identity/**/*.{ts,tsx}": [
			"pnpm -C packages/identity exec eslint --fix"
		]
	},
	"packageManager": "pnpm@10.27.0",
	"engines": {
		"node": "20.x"
	},
	"pnpm": {
		"overrides": {
			"axios": "1.13.2",
			"esbuild": "0.25.12"
		}
	}
}