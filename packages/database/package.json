{
  "name": "@nexiom/database",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema/identity": {
      "types": "./dist/schema/global/identity.d.ts",
      "import": "./dist/schema/global/identity.js",
      "default": "./dist/schema/global/identity.js"
    },
    "./schema/tenant": {
      "types": "./dist/schema/tenant/tenant.d.ts",
      "import": "./dist/schema/tenant/tenant.js",
      "default": "./dist/schema/tenant/tenant.js"
    },
    "./dist/schema/identity": {
      "types": "./dist/schema/global/identity.d.ts",
      "import": "./dist/schema/global/identity.js",
      "default": "./dist/schema/global/identity.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:migrate": "pnpm build && drizzle-kit migrate",
    "db:studio": "pnpm build && drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.7.3"
  }
}