{
  "name": "@soopa/piece-salesforce",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./trigger": {
      "types": "./dist/lib/trigger/index.d.ts",
      "import": "./dist/lib/trigger/index.js",
      "default": "./dist/lib/trigger/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.lib.json",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@soopa/credentials": "workspace:*",
    "@soopa/piece-framework": "workspace:*",
    "dayjs": "^1.11.19"
  }
}
