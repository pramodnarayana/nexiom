{
  "openapi": "3.0.3",
  "info": {
    "title": "Salesforce REST API (stub)",
    "description": "Minimal mock spec for local Prism development — covers object listing and field describe.",
    "version": "59.0"
  },
  "servers": [
    { "url": "http://localhost:4010" }
  ],
  "paths": {
    "/services/data/v59.0/sobjects": {
      "get": {
        "operationId": "listSObjects",
        "summary": "List all SObjects",
        "responses": {
          "200": {
            "description": "List of available SObjects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "encoding": { "type": "string", "example": "UTF-8" },
                    "maxBatchSize": { "type": "integer", "example": 200 },
                    "sobjects": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/SObjectDescriptorBrief" }
                    }
                  }
                },
                "example": {
                  "encoding": "UTF-8",
                  "maxBatchSize": 200,
                  "sobjects": [
                    {
                      "name": "Account",
                      "label": "Account",
                      "labelPlural": "Accounts",
                      "keyPrefix": "001",
                      "queryable": true,
                      "createable": true,
                      "updateable": true,
                      "custom": false,
                      "urls": {
                        "sobject": "/services/data/v59.0/sobjects/Account",
                        "describe": "/services/data/v59.0/sobjects/Account/describe"
                      }
                    },
                    {
                      "name": "Contact",
                      "label": "Contact",
                      "labelPlural": "Contacts",
                      "keyPrefix": "003",
                      "queryable": true,
                      "createable": true,
                      "updateable": true,
                      "custom": false,
                      "urls": {
                        "sobject": "/services/data/v59.0/sobjects/Contact",
                        "describe": "/services/data/v59.0/sobjects/Contact/describe"
                      }
                    },
                    {
                      "name": "Opportunity",
                      "label": "Opportunity",
                      "labelPlural": "Opportunities",
                      "keyPrefix": "006",
                      "queryable": true,
                      "createable": true,
                      "updateable": true,
                      "custom": false,
                      "urls": {
                        "sobject": "/services/data/v59.0/sobjects/Opportunity",
                        "describe": "/services/data/v59.0/sobjects/Opportunity/describe"
                      }
                    },
                    {
                      "name": "rtms__Load__c",
                      "label": "Load",
                      "labelPlural": "Loads",
                      "keyPrefix": "a00",
                      "queryable": true,
                      "createable": true,
                      "updateable": true,
                      "custom": true,
                      "urls": {
                        "sobject": "/services/data/v59.0/sobjects/rtms__Load__c",
                        "describe": "/services/data/v59.0/sobjects/rtms__Load__c/describe"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/services/data/v59.0/sobjects/{objectName}/describe": {
      "get": {
        "operationId": "describeSObject",
        "summary": "Describe fields for a given SObject",
        "parameters": [
          {
            "name": "objectName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "Account"
          }
        ],
        "responses": {
          "200": {
            "description": "SObject metadata including field definitions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SObjectDescribe" },
                "example": {
                  "name": "Account",
                  "label": "Account",
                  "labelPlural": "Accounts",
                  "keyPrefix": "001",
                  "fields": [
                    {
                      "name": "Id",
                      "label": "Account ID",
                      "type": "id",
                      "length": 18,
                      "nillable": false,
                      "createable": false,
                      "updateable": false,
                      "unique": true
                    },
                    {
                      "name": "Name",
                      "label": "Account Name",
                      "type": "string",
                      "length": 255,
                      "nillable": false,
                      "createable": true,
                      "updateable": true,
                      "unique": false
                    },
                    {
                      "name": "Industry",
                      "label": "Industry",
                      "type": "picklist",
                      "length": 40,
                      "nillable": true,
                      "createable": true,
                      "updateable": true,
                      "unique": false
                    },
                    {
                      "name": "AnnualRevenue",
                      "label": "Annual Revenue",
                      "type": "currency",
                      "length": 0,
                      "nillable": true,
                      "createable": true,
                      "updateable": true,
                      "unique": false
                    },
                    {
                      "name": "BillingCity",
                      "label": "Billing City",
                      "type": "string",
                      "length": 40,
                      "nillable": true,
                      "createable": true,
                      "updateable": true,
                      "unique": false
                    },
                    {
                      "name": "CreatedDate",
                      "label": "Created Date",
                      "type": "datetime",
                      "length": 0,
                      "nillable": false,
                      "createable": false,
                      "updateable": false,
                      "unique": false
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SObjectDescriptorBrief": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "labelPlural": { "type": "string" },
          "keyPrefix": { "type": "string" },
          "queryable": { "type": "boolean" },
          "createable": { "type": "boolean" },
          "updateable": { "type": "boolean" },
          "custom": { "type": "boolean" },
          "urls": {
            "type": "object",
            "properties": {
              "sobject": { "type": "string" },
              "describe": { "type": "string" }
            }
          }
        }
      },
      "SObjectDescribe": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "labelPlural": { "type": "string" },
          "keyPrefix": { "type": "string" },
          "fields": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SObjectField" }
          }
        }
      },
      "SObjectField": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "length": { "type": "integer" },
          "nillable": { "type": "boolean" },
          "createable": { "type": "boolean" },
          "updateable": { "type": "boolean" },
          "unique": { "type": "boolean" }
        }
      }
    }
  }
}
