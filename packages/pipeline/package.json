{
  "name": "@soopa/pipeline",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@nestjs/event-emitter": "^3.1.0",
    "@soopa/credentials": "workspace:*",
    "@soopa/database": "workspace:*",
    "@soopa/piece-framework": "workspace:*",
    "ai": "^6.0.146",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.3.5",
    "@soopa/queue": "workspace:*",
    "@soopa/piece-registry": "workspace:*",
    "@soopa/dbmanager": "workspace:*",
    "@soopa/domain-core": "workspace:*",
    "@soopa/cache": "workspace:*",
    "@soopa/mapping": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18",
    "@types/jest": "^29.5.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2"
  }
}