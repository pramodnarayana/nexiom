{
	"name": "@soopa/infra",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint \"src/**/*.ts\" --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-kms": "^3.750.0"
	},
	"peerDependencies": {
		"@nestjs/common": "^11.1.11",
		"@nestjs/core": "^11.1.11",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/common": "^11.1.11",
		"@nestjs/core": "^11.1.11",
		"@types/node": "^20.14.9",
		"@vitest/coverage-v8": "^4.0.18",
		"rxjs": "^7.8.1",
		"@eslint/js": "^9.39.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.3",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.46.4",
		"unplugin-swc": "^1.5.9",
		"vitest": "^4.0.18"
	}
}
