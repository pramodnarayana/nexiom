{
	"name": "@soopa/credentials",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nestjs/config": "^4.0.2",
		"@nestjs/event-emitter": "^3.1.0",
		"@soopa/database": "workspace:*",
		"@soopa/piece-framework": "workspace:*",
		"drizzle-orm": "^0.45.1",
		"ioredis": "^5.10.0"
	},
	"devDependencies": {
		"@nestjs/common": "^11.1.11",
		"@vitest/coverage-v8": "^4.0.18",
		"typescript": "^5.7.3",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"@nestjs/common": "^11.1.11"
	}
}
