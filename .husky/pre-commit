

echo "🔍 Running pre-commit checks..."

# Automatically generate and stage Drizzle migrations for plugins
echo "🛠️ Generating database migrations for plugins..."
pnpm turbo run db:generate --filter="./plugins/**" || exit 1
git add "plugins/**/drizzle/migrations/*" 2>/dev/null || true

# Run lint on staged files first (fast feedback)
echo "📝 Linting staged files..."
pnpm lint-staged --concurrent false || exit 1

# Run full lint check
echo "🔎 Running full lint check..."
pnpm lint || exit 1

# Run build check (Strict Type Checking)
echo "🏗️  Running type check..."
pnpm typecheck || exit 1

# Run tests with coverage
echo "🧪 Running tests with coverage..."
pnpm test:cov || exit 1

echo "✅ All pre-commit checks passed!"
