{
  "name": "@soopa/piece-salesforce",
  "version": "0.6.8",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./trigger": {
      "types": "./dist/lib/trigger/index.d.ts",
      "require": "./dist/lib/trigger/index.js",
      "import": "./dist/lib/trigger/index.js",
      "default": "./dist/lib/trigger/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.lib.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint .",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@soopa/piece-framework": "workspace:*",
    "@types/node-fetch": "^2.6.13",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "dayjs": "^1.11.19",
    "node-fetch": "^2.7.0"
  },
  "files": [
    "dist"
  ]
}
