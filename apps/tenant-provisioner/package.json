{
  "name": "tenant-provisioner",
  "version": "0.0.1",
  "type": "module",
  "description": "Nexiom Tenant Provisioner — isolates DDL-level database provisioning from the API control plane.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:cov": "tsc --noEmit && vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@soopa/database": "workspace:*",
    "@soopa/queue": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.15.11",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.9"
  }
}
