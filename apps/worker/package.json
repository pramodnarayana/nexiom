{
  "name": "worker",
  "version": "0.0.1",
  "type": "module",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "docker:build": "docker build -t nexiom-worker:latest -f Dockerfile ../..",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:drop": "tsx ../api/src/db/cli/main.ts db:drop",
    "db:seed": "tsx ../api/src/db/cli/main.ts db:seed",
    "db:fresh": "tsx ../api/src/db/cli/main.ts db:fresh",
    "db:reset": "tsx ../api/src/db/cli/main.ts db:reset",
    "db:provision:local": "tsx ../api/src/db/cli/main.ts db:provision:local",
    "db:check-role": "tsx ../api/src/db/cli/main.ts db:check-role",
    "test:watch": "vitest",
    "test:cov": "tsc --noEmit && vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --pool=forks",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.58",
    "@bufbuild/protobuf": "^2.10.2",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@soopa/ai": "workspace:*",
    "@soopa/auth": "workspace:*",
    "@soopa/cache": "workspace:*",
    "@soopa/credentials": "workspace:*",
    "@soopa/database": "workspace:*",
    "@soopa/dbmanager": "workspace:*",
    "@soopa/domain-core": "workspace:*",
    "@soopa/pipeline": "workspace:*",
    "@soopa/identity": "workspace:*",
    "@soopa/piece-framework": "workspace:*",
    "@soopa/piece-registry": "workspace:*",
    "@soopa/queue": "workspace:*",
    "ai": "^6.0.146",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.0.1",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.5",
    "@soopa/observability": "workspace:*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.11",
    "@nx/webpack": "^22.4.5",
    "@swc/core": "^1.15.11",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.4",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.18",
    "webpack-node-externals": "^3.0.0"
  }
